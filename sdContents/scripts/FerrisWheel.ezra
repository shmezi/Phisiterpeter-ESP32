print "----------------------"
print "|    Ferris Wheel    |"
print "----------------------"

m = motor 10 11 12 15 16


screen "ferriswheel"
started = false
on "start" {
    if not started{
        started = true
        reset m

        move m value

        after 5000 {
            move m 0
            started = false
            endActivity
        }}2

}
when true {
    sendResult "b" abs rotations m


}

on "stop" {
    move m 0
}