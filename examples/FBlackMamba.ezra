print "----------------------"
print "|     Black Mamba     |"
print "----------------------"

screen "blackmamba"

topPin = 18
bottomPin = 40

sensorAPin = 41
sensorBPin = 42

servoPin = 17

m = motor 10 11 12 15 16


startTime = now
reachedTop = false
reachedBottom = false
once read bottomPin and not reachedTop{
reachedTop = true

sendResult "a" (now - startTime)
print "Reached bottom"
after 3000 {
servo servoPin 0
move m (0 - 60)
}


}
once read sensorAPin{
sendResult "b" (now - startTime)


}
once read sensorBPin{
sendResult "c" (now - startTime)


}


once read topPin and reachedTop {
reachedTop = false
print "Reached top"
servo servoPin 180
after 500 {
move m 100
after 1000{
move m 0
}

}
}
on "start" {
print "Started!"
servo servoPin 0
sendResult "a" 0
sendResult "b" 0
sendResult "c" 0
startTime = now

}

on "stop"{
print "Stopped?"
}