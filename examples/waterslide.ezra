
on "start" {
write 12 true

}
on "stop" {
write 12 false

}

startTime = 0
fn startAttraction () {
startTime = now
sendResult "a" 0
sendResult "b" 0
sendResult "c" 0
}

when (not read 13) {
    startAttraction
}

when (not read 14) {
    sendResult "a" (now - startTime )
}

when (not read 17) {
    sendResult "b" (now - startTime )
}
when (not read 18) {
    sendResult "c" (now - startTime )
    endActivity
}